{
  "name": "tuchat-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -f public/sitemap-*.xml && next-sitemap && npx tsx scripts/content/generar-llms-full.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:news": "npx tsx scripts/generate-news.ts",
    "curar": "npx tsx scripts/cron/curacion-contenido.ts --aplicar",
    "auditar": "npx tsx scripts/content/auditar-contenido.ts",
    "generate:rooms": "npx tsx scripts/generate-room-content.ts",
    "salas:cron": "npx tsx scripts/cron/salas-geo.mjs --lote 12",
    "salas:cola": "npx tsx scripts/localidades/preparar-dataset.mjs",
    "salas:cobertura": "npx tsx scripts/localidades/auditar-cobertura.mjs",
    "salas:demanda": "npx tsx scripts/localidades/cruzar-demanda.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "auditar:html": "node scripts/content/auditar-html.mjs",
    "llms:full": "npx tsx scripts/content/generar-llms-full.ts",
    "cf:purge": "node scripts/cloudflare-purge.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "next-sitemap": "^4.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
