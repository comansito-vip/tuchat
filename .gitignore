# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project brief / brainstorm files (not part of the codebase)
.superpowers/
_brief/

# Local votes store
.data/

# Generado en el postbuild a partir de src/data (2,3 MB): se reconstruye en cada build.
public/llms-full.txt

# Caché del cliente de Search Console: guarda tokens OAuth de las service
# accounts, así que no puede entrar en el repositorio.
data/.gsc-cache/

# Progreso reanudable del backfill de H2 (el resultado vive en src/data/about-titles.ts)
/data/about-titles-progreso.json
