# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project brief / brainstorm files (not part of the codebase)
.superpowers/
_brief/

# Local votes store
.data/

# Generado en el postbuild a partir de src/data (2,3 MB): se reconstruye en cada build.
public/llms-full.txt

# Caché del cliente de Search Console: guarda tokens OAuth de las service
# accounts, así que no puede entrar en el repositorio.
data/.gsc-cache/

# Progreso reanudable del backfill de H2 (el resultado vive en src/data/about-titles.ts)
/data/about-titles-progreso.json

# Sitemaps: los genera next-sitemap en cada postbuild, así que versionarlos solo
# guardaba una foto vieja. Y hacía daño: el deploy hace `git reset --hard` antes
# de construir, con lo que restauraba esa foto y la servía durante los quince
# minutos del build —el 12 de agosto de 2026 el sitemap en producción no tenía
# ninguna de las salas publicadas ese día—. Ningún cron los commitea (el goteo
# solo mete src/data y data/localidades), así que nunca se iban a poner al día.
/public/sitemap.xml
/public/sitemap-*.xml
