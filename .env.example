# ─── Variables de entorno de TuChat ───
# Copia este fichero a .env.local (desarrollo) o configúralas en el VPS.

# Client ID del iframe de ChatZona que carga /webchat.
NEXT_PUBLIC_WEBCHAT_CLIENT_ID=af9476269cf237c0196b

# ─── Opcionales ───
# Sin estas, la app funciona igual: store de votos en fichero y noticias
# curadas estáticas. Se activan solas cuando defines las variables.

# Votos persistidos en SERVERLESS (Vercel, etc.). En un VPS dedicado NO hacen
# falta: el store en fichero .data/votes.json ya es durable. Base gratis en
# https://upstash.com → copia sus credenciales REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generación de noticias multi-LLM (npm run generate:news).
# Claude primario, OpenAI fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Resultados/clasificaciones deportivas (/resultados). Cadena de proveedores con
# fallback: football-data.org → API-Football → TheSportsDB (gratis, sin clave) →
# datos de reserva. Define las que tengas; TheSportsDB funciona sin clave.
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=
THESPORTSDB_KEY=

# Resultados reales de loterías españolas (/loterias/espana): se leen del
# endpoint oficial de loteriasyapuestas.es (SELAE), gratis y sin key —
# ver src/lib/lottery.ts. No hay variable que configurar aquí.

# Acceso al panel /admin (Basic Auth). Si ADMIN_PASS está vacío, el panel queda
# abierto (dev). Define una contraseña en el VPS para protegerlo.
ADMIN_USER=admin
ADMIN_PASS=
